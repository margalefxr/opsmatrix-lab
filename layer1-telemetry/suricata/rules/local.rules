# ==============================================================================
# OpsMatrix-Lab — Reglas propias de Suricata
# Archivo activo en la VM: /var/lib/suricata/rules/local.rules
#   (default-rule-path de /etc/suricata/suricata.yaml)
# Instalar: sudo install -m 644 layer1-telemetry/suricata/rules/local.rules /var/lib/suricata/rules/local.rules
# ==============================================================================

# Regla 1 (MF0488): ping o cualquier ICMP
alert icmp any any -> any any (msg:"[SEC-ALERT] Traza ICMP Detectada en enp2s0"; sid:1000001; rev:1;)

# Regla 2 (MF0488): cualquier acceso TCP al puerto 80
alert tcp any any -> any 80 (msg:"[SEC-ALERT] Acceso Web HTTP a Nginx Detectado"; sid:1000002; rev:1;)

# Regla 3 (MF0489 Fase 4): cada conexión nueva (SYN) al 443 del servidor.
# Es una regla de laboratorio para correlacionar con Nginx, no detecta ataques.
alert tcp any any -> $HOME_NET 443 (msg:"MF0489 - Conexion HTTPS observada"; flags:S; sid:1000003; rev:1;)
