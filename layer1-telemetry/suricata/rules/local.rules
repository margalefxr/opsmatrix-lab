# ==============================================================================
# OpsMatrix-Lab — Reglas Personalizadas NIDS (Suricata)
# ==============================================================================

# Regla 1: Detección de Ping ICMP al Host (Línea Base)
alert icmp any any -> $HOME_NET any (msg:"[OPSMATRIX-NIDS] Traza ICMP Detectada en Host"; sid:1000001; rev:1;)

# Regla 2: Detección de Intento de Escaneo Nmap / User-Agent Sospechoso en HTTP
alert http any any -> $HOME_NET 80 (msg:"[OPSMATRIX-NIDS] Escaneo HTTP Nmap/Nikto Detectado"; content:"Nmap"; http_user_agent; sid:1000002; rev:1;)
